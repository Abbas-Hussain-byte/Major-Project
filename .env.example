# ==============================================================================
# BenefitLens - Production Environment Configuration Template
# ==============================================================================

# Core Application Settings
PORT=5000
NODE_ENV=production

# Database (MongoDB Atlas Free Tier M0 Recommended)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/benefitlens?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/benefitlens?retryWrites=true&w=majority

# Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-2

# Sarvam AI Native Speech (https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key

# Groq Cloud LLM Fallback (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_optional

# Bhashini Pipeline (https://bhashini.gov.in/ulca/model/explore/automatic)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# CORS Settings (Comma-separated for multiple origins, or * for open access)
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# File Uploads (local disk in uploads/)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# Split Deployment Only (Optional: only needed if frontend is on Vercel while backend is on Render)
# VITE_API_URL=https://your-backend.onrender.com/api
