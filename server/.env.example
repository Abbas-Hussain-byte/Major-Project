PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/benefitlens?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Bhashini API (https://bhashini.gov.in/ulca/model/explore/automatic)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Groq (https://console.groq.com) — fallback LLM
GROQ_API_KEY=

# File uploads (local disk for dev; swap to S3/Cloudinary for prod)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# CORS
CLIENT_ORIGIN=http://localhost:5173
